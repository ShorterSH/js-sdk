{
  "name": "shorter.sh",
  "version": "1.0.0",
  "description": "CLI and SDK for the shorter.sh URL shortener",
  "author": "ShorterSH",
  "homepage": "https://shorter.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShorterSH/js-sdk"
  },
  "bugs": {
    "url": "https://github.com/ShorterSH/js-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "shorter": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "url-shortener",
    "link-shortener",
    "short-url",
    "shorter.sh",
    "cli",
    "sdk"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
